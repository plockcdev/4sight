{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["why", "summary", "description", "details", "review", "ready", "file_reviews"],
  "properties": {
    "why": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1, "maxLength": 65},
    "description": {"type": "string"},
    "details": {"type": "string"},
    "review": {"type": "string", "minLength": 1},
    "ready": {"type": "boolean"},
    "file_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "why", "summary", "description", "details", "body_summary"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "why": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1, "maxLength": 65},
          "description": {"type": "string"},
          "details": {"type": "string"},
          "body_summary": {"type": "string", "minLength": 1, "maxLength": 65}
        }
      }
    }
  }
}
